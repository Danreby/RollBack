<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roda o núcleo do Motion Matching (Assets/Scripts/MotionMatching/Core) fora da Unity:
       cenários de input -> poses gravadas em arquivo, para medir e renderizar com analyze.py -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/Scripts/MotionMatching/Core/*.cs" />
  </ItemGroup>
</Project>
